# このファイルを .env にコピーして値を設定する（.env はGitHubにアップロードされない）
# cp .env.example .env

# NeonのPostgres接続URL
# DATABASE_URL: Neonの「Pooled connection」（ホスト名に -pooler が入っている方）
# DIRECT_URL:   Neonの「Direct connection」（-pooler なしの方）。prisma db push で使う
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# チーム共通パスワード。本番では必ず強いものに変更すること
TEAM_PASSWORD="ここを変更"
